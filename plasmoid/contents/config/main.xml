<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">

    <group name="General">
        <entry name="interval" type="Int">
            <default>45</default>
        </entry>

        <entry name="startOnBoot" type="Bool">
            <default>true</default>
        </entry>

        <entry name="repeat" type="Bool">
            <default>true</default>
        </entry>
    </group>
</kcfg>
